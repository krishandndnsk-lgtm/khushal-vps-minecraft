# =====================
# KHUSHAL VPS Environment
# =====================

# Database
DATABASE_URL=sqlite:./data/khushal.db

# =====================
# VPS SSH Connection
# =====================
# Required for real server management
# Leave blank to run in development mode (no SSH)

VPS_HOST=your-vps-ip-or-hostname
VPS_PORT=22
VPS_USERNAME=root

# SSH Authentication - CHOOSE ONE:
# Option 1: Private Key (Recommended)
VPS_PRIVATE_KEY_PATH=/path/to/id_rsa
# Option 2: Password (Less secure)
# VPS_PASSWORD=your-ssh-password

# Minecraft working directory on VPS
VPS_ROOT_PATH=/opt/minecraft

# =====================
# Application Settings
# =====================
NEXT_PUBLIC_APP_NAME=KHUSHAL VPS
NEXT_PUBLIC_APP_TAGLINE=Power Your Minecraft. Your Way.
NEXT_PUBLIC_MAX_RAM_GB=32

# =====================
# Authentication
# =====================
# Change these in production!
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_EXPIRY=7d
SESSION_SECRET=your-super-secret-session-key-minimum-32-characters-change-in-production

# =====================
# Rate Limiting
# =====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================
# Minecraft Defaults
# =====================
MINECRAFT_DEFAULT_PORT=25565
MINECRAFT_DEFAULT_VERSION=1.20.1
MINECRAFT_MAX_MEMORY_GB=24
MINECRAFT_MIN_MEMORY_GB=2

# =====================
# File Upload & Backups
# =====================
MAX_FILE_SIZE_MB=500
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24

# =====================
# Logging
# =====================
# Set to 'debug' for verbose SSH/server logs
LOG_LEVEL=info
